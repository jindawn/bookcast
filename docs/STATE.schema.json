{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookCast repository handoff state v1",
  "description": "Repository workflow state, not application job state. Change schema_version for incompatible changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "current_phase", "current_task", "task_status", "branch", "last_verified_commit", "completed_tasks", "in_progress", "next_actions", "tests", "known_failures", "blockers", "important_files", "updated_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project": {"type": "string", "const": "BookCast"},
    "current_phase": {"type": "string", "pattern": "^phase-[0-9]+$"},
    "current_task": {"type": "string", "minLength": 1},
    "task_status": {"type": "string", "enum": ["not_started", "in_progress", "blocked", "completed"]},
    "branch": {"type": "string", "minLength": 1},
    "last_verified_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "completed_tasks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "in_progress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "owner", "files"],
        "properties": {
          "task": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "status", "scope", "summary", "checked_at"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["not_run", "passed", "failed", "blocked"]},
          "scope": {"type": "string", "enum": ["working_tree", "commit"]},
          "summary": {"type": "string", "minLength": 1},
          "checked_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
        }
      }
    },
    "known_failures": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "important_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
